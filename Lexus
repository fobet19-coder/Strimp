    IntensLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    IntensLabel.Font = Enum.Font.Gotham
    IntensLabel.TextSize = 10
    IntensLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- Botones Intensidad (+ / -)
    local PlusIntens = Instance.new("TextButton", MainFrame)
    PlusIntens.Size = UDim2.new(0, 92, 0, 22)
    PlusIntens.Position = UDim2.new(0, 10, 0, 203)
    PlusIntens.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    PlusIntens.Text = "+ Fuerza"
    PlusIntens.TextColor3 = Color3.fromRGB(255, 255, 255)
    PlusIntens.Font = Enum.Font.Gotham
    PlusIntens.TextSize = 10
    Instance.new("UICorner", PlusIntens).CornerRadius = UDim.new(0, 4)

    PlusIntens.MouseButton1Click:Connect(function()
        if _G.AimIntensity < 1.0 then
            _G.AimIntensity = math.clamp(_G.AimIntensity + 0.1, 0.1, 1.0)
            IntensLabel.Text = "Fuerza Aimlock: " .. string.format("%.2f", _G.AimIntensity)
        end
    end)

    local MinusIntens = Instance.new("TextButton", MainFrame)
    MinusIntens.Size = UDim2.new(0, 92, 0, 22)
    MinusIntens.Position = UDim2.new(0, 118, 0, 203)
    MinusIntens.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    MinusIntens.Text = "- Fuerza"
    MinusIntens.TextColor3 = Color3.fromRGB(255, 255, 255)
    MinusIntens.Font = Enum.Font.Gotham
    MinusIntens.TextSize = 10
    Instance.new("UICorner", MinusIntens).CornerRadius = UDim.new(0, 4)

    MinusIntens.MouseButton1Click:Connect(function()
        if _G.AimIntensity > 0.1 then
            _G.AimIntensity = math.clamp(_G.AimIntensity - 0.1, 0.1, 1.0)
            IntensLabel.Text = "Fuerza Aimlock: " .. string.format("%.2f", _G.AimIntensity)
        end
    end)

    -- Botón OFF (Ocultar Menú)
    local OffBtn = Instance.new("TextButton", MainFrame)
    OffBtn.Size = UDim2.new(1, -20, 0, 24)
    OffBtn.Position = UDim2.new(0, 10, 0, 285)
    OffBtn.BackgroundColor3 = Color3.fromRGB(100, 20, 20)
    OffBtn.Text = "Ocultar / OFF Menú"
    OffBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    OffBtn.Font = Enum.Font.GothamBold
    OffBtn.TextSize = 10
    Instance.new("UICorner", OffBtn).CornerRadius = UDim.new(0, 4)

    -- Botón flotante para volver a abrir el menú
    local OpenButton = Instance.new("TextButton", ScreenGui)
    OpenButton.Size = UDim2.new(0, 36, 0, 36)
    OpenButton.Position = UDim2.new(0, 10, 0.5, -18)
    OpenButton.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    OpenButton.Text = "⚡"
    OpenButton.TextSize = 16
    OpenButton.Visible = false
    Instance.new("UICorner", OpenButton).CornerRadius = UDim.new(0, 8)
    local OpenStroke = Instance.new("UIStroke", OpenButton)
    OpenStroke.Color = Color3.fromRGB(255, 140, 0)
    OpenStroke.Thickness = 2

    OffBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
        OpenButton.Visible = true
    end)

    OpenButton.MouseButton1Click:Connect(function()
        MainFrame.Visible = true
        OpenButton.Visible = false
    end)

    -- Dibujo del FOV Rainbow
    local FOVCircle = Drawing.new("Circle")
    FOVCircle.Filled = false
    FOVCircle.Thickness = 2
    FOVCircle.Visible = false
    FOVCircle.NumSides = 60

    -- Sistema de Dibujo para Names y Tracers Rojos
    local NamesCache = {}
    local TracersCache = {}

    local function CreateESP(player)
        if player == LP then return end
        
        -- Text ESP (Names)
        local nameObj = Drawing.new("Text")
        nameObj.Visible = false
        nameObj.Center = true
        nameObj.Outline = true
        nameObj.Font = 2
        nameObj.Size = 13
        nameObj.Color = Color3.fromRGB(255, 255, 255)
        NamesCache[player] = nameObj
        
        -- Line ESP (Tracers Rojos)
        local tracerObj = Drawing.new("Line")
        tracerObj.Visible = false
        tracerObj.Thickness = 1.5
        tracerObj.Color = Color3.fromRGB(255, 0, 0)
        TracersCache[player] = tracerObj
    end

    local function RemoveESP(player)
        if NamesCache[player] then
            NamesCache[player]:Remove()
            NamesCache[player] = nil
        end
        if TracersCache[player] then
            TracersCache[player]:Remove()
            TracersCache[player] = nil
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do CreateESP(p) end
    Players.PlayerAdded:Connect(CreateESP)
    Players.PlayerRemoving:Connect(RemoveESP)

    -- Algoritmo de Aimlock
    local function GetClosestTarget()
        local TargetPart = nil
        local ClosestDistance = math.huge
        
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return nil end
        local myPosition = LP.Character.HumanoidRootPart.Position
        local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LP and player.Character then
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                local targetPart = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
                
                if humanoid and humanoid.Health > 0 and targetPart then
                    local worldPos = targetPart.Position
                    local distance = (worldPos - myPosition).Magnitude
                    
                    if distance <= _G.MaxDistance then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
                        if onScreen then
                            local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if screenDist <= _G.FOVRadius and screenDist < ClosestDistance then
                                ClosestDistance = screenDist
                                TargetPart = targetPart
                            end
                        end
                    end
                end
            end
        end
        return TargetPart
    end

    -- Motor Principal en Tiempo Real
    RunService.RenderStepped:Connect(function()
        pcall(function()
            -- 1. FOV Rainbow
            if _G.AimEnabled then
                FOVCircle.Visible = true
                FOVCircle.Radius = _G.FOVRadius
                FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                FOVCircle.Color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
            else
                FOVCircle.Visible = false
            end

            -- 2. Aimlock con intensidad ajustable
            if _G.AimEnabled then
                local Target = GetClosestTarget()
                if Target then
                    local currentCFrame = Camera.CFrame
                    local targetCFrame = CFrame.new(currentCFrame.Position, Target.Position)
                    Camera.CFrame = currentCFrame:Lerp(targetCFrame, _G.AimIntensity)
                end
            end

            -- 3. Names y Tracers
            for player, nameObj in pairs(NamesCache) do
                local tracerObj = TracersCache[player]
                local character = player.Character
                local head = character and character:FindFirstChild("Head")
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                
                local isValid = character and head and rootPart and humanoid and humanoid.Health > 0
                
                -- Gestionar Names
                if _G.NamesEnabled and isValid then
                    local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))
                    if onScreen then
                        nameObj.Text = player.Name
                        nameObj.Position = Vector2.new(headPos.X, headPos.Y)
                        nameObj.Visible = true
                    else
                        nameObj.Visible = false
                    end
                else
                    nameObj.Visible = false
                end
                
                -- Gestionar Tracers Rojos
                if _G.TracersEnabled and isValid and tracerObj then
                    local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    if onScreen then
                        tracerObj.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        tracerObj.To = Vector2.new(rootPos.X, rootPos.Y)
                        tracerObj.Visible = true
                    else
                        tracerObj.Visible = false
                    end
                elseif tracerObj then
                    tracerObj.Visible = false
                end
            end
        end)
    end)
end

-- Lógica del botón de verificación
CheckBtn.MouseButton1Click:Connect(function()
    if TextBox.Text == CORRECT_KEY then
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
        StatusLabel.Text = "¡Key correcta! Cargando..."
        task.wait(0.6)
        LoadMainHub()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        StatusLabel.Text = "Key incorrecta. Intenta de nuevo."
    end
end)
